{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "einsvamp",
  "compatibility_date": "2026-08-11",
  // Assets-only deployment: there is no Worker script, the whole site is the
  // static output of `vite build`. Without this file wrangler tries to
  // scaffold a Worker on every build and fails trying to rewrite vite.config.
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application"
  },
  "observability": {
    "enabled": true
  }
}
