{
  "name": "einsvamp",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Generate and export SVG tilings of the Spectre aperiodic monotile",
  "scripts": {
    "dev": "vite --host dev.local --port 4114",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host dev.local --port 4114",
    "check": "node --experimental-strip-types src/check.ts",
    "typecheck": "tsc --noEmit",
    "e2e": "npm --prefix tool install --no-audit --no-fund --silent && node --experimental-strip-types tool/e2e.ts",
    "render": "node --experimental-strip-types tool/render-svg.ts",
    "deploy": "npm run build && wrangler deploy",
    "typecheck:tool": "npm --prefix tool install --no-audit --no-fund --silent && tsc -p tsconfig.tool.json"
  },
  "devDependencies": {
    "@types/node": "^22.20.1",
    "typescript": "^5.9.3",
    "vite": "^7.1.9",
    "wrangler": "^4.120.1"
  }
}
