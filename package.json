{
  "name": "einsvamp",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Generate and export SVG tilings of the Spectre aperiodic monotile",
  "scripts": {
    "dev": "vite --host dev.local --port 4114",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host dev.local --port 4114",
    "check": "node --experimental-strip-types src/check.ts",
    "typecheck": "tsc --noEmit",
    "e2e": "node --experimental-strip-types tool/e2e.ts",
    "render": "node --experimental-strip-types tool/render-svg.ts"
  },
  "devDependencies": {
    "@types/node": "^22.20.1",
    "playwright-core": "^1.56.1",
    "typescript": "^5.9.3",
    "vite": "^7.1.9"
  }
}
